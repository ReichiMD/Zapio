    <string name="devices_scan_new_at">%1$s · new, tap to connect</string>
    <string name="devices_scan_none">No TV with ADB debugging found. Is the TV on and ADB debugging turned on? You can also enter the IP address.</string>
    <string name="devices_scan_only_known">Only TVs that are already in your list.</string>
    <string name="devices_scan_no_wifi">The phone is not in a Wi-Fi network. Connect it to the same Wi-Fi as the TV.</string>
    <string name="devices_prepare_title">Get your TV ready</string>
    <string name="devices_prepare_step_1">On the TV, open Settings and find the device info page (often called “About”).</string>
    <string name="devices_prepare_step_2">Select the build number seven times until developer options are turned on.</string>
    <string name="devices_prepare_step_3">In developer options, turn on ADB debugging (sometimes called network debugging).</string>
    <string name="devices_prepare_step_4">Keep the phone and the TV on the same Wi-Fi.</string>
    <string name="devices_prepare_hint">Only do this on your own TV and home network, and turn ADB debugging off again when you don’t need it.</string>

    <!-- Adding and connecting a TV -->
    <string name="ip_title">Enter IP address</string>
    <string name="ip_text">The TV shows its IP address in its settings, usually under Network or About.</string>
    <string name="ip_label">IP address</string>
    <string name="ip_invalid">That is not an IP address. It looks like four numbers with dots, for example 192.168.0.10.</string>
    <string name="ip_connect">Connect</string>
    <string name="connect_title">Connecting to %1$s</string>
    <string name="connect_text">If the TV asks “Allow USB debugging?”, tick “Always allow from this computer” and choose OK.</string>
    <string name="connect_failed_title">Could not connect</string>
    <string name="connect_retry">Try again</string>
    <string name="problem_adb_off">The TV answers, but ADB debugging is off. Turn it on in the TV’s developer options.</string>
    <string name="problem_no_answer">The TV does not answer. Is it switched on and in the same Wi-Fi as the phone? Check the IP address too.</string>
    <string name="problem_not_allowed">The TV did not allow the connection. Look at the TV screen: tick “Always allow from this computer”, choose OK and try again.</string>
    <string name="problem_connection_lost">The connection to the TV broke off. Try again.</string>

