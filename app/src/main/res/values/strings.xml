    <string name="install_problem_not_an_apk">This is not a working APK file. It may be broken or incomplete, download it again.</string>
    <string name="install_problem_no_space">The TV does not have enough free space. Remove apps or files on the TV and try again.</string>
    <string name="install_problem_signature">This app is already on the TV, but from a different source. Uninstall it on the TV first.</string>
    <string name="install_problem_older_version">The TV already has a newer version of this app.</string>
